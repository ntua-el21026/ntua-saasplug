# Application
APP_ENV=development
SAASPLUG_STRICT_SECRETS=false
COMPOSE_PROJECT_NAME=saasplug15
GATEWAY_HTTP_PORT=3315

# JWT / Auth - replace before demo/production strict mode
JWT_SECRET=[REDACTED_EXPOSED_CREDENTIAL]
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEMO_USER_PASSWORD=saasPlug15!
RESET_DEMO_USERS_ON_STARTUP=false

# Google OAuth
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
PUBLIC_BASE_URL=http://saasprojects.softlab.ntua.gr:3315
GOOGLE_REDIRECT_URI=http://saasprojects.softlab.ntua.gr:3315/api/auth/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URI=http://saasprojects.softlab.ntua.gr:3315/login/google/callback

# RabbitMQ - guest/guest is local-only; replace before strict demo/production runs.
RABBITMQ_DEFAULT_USER=saasplug15
RABBITMQ_DEFAULT_PASS=saasplug15
RABBITMQ_ERLANG_COOKIE=saasplug-local-cookie
RABBITMQ_MANAGEMENT_PORT=4415
RABBITMQ_URL=amqp://saasplug15:saasplug15@rabbitmq:5672/
RABBITMQ_EVENT_EXCHANGE=saasplug.events
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=5
RABBITMQ_TOPOLOGY_DECLARE_ON_STARTUP=false
CATALOG_RABBITMQ_EVENT_PUBLISH_ENABLED=true
STATUS_RABBITMQ_EVENT_PUBLISH_ENABLED=true
ANALYTICS_RABBITMQ_CONSUME_BATCH_SIZE=50
ANALYTICS_RABBITMQ_CONSUME_TIMEOUT_SECONDS=5
ANALYTICS_RABBITMQ_TOPOLOGY_DECLARE_ON_STARTUP=false
BILLING_RABBITMQ_CONSUME_BATCH_SIZE=50
BILLING_RABBITMQ_CONSUME_TIMEOUT_SECONDS=5
BILLING_RABBITMQ_TOPOLOGY_DECLARE_ON_STARTUP=false
BILLING_DEFAULT_CURRENCY=EUR
BILLING_DEFAULT_RESERVATION_SUCCESS_FEE=0.50
BILLING_DEFAULT_POINT_VIEW_FEE=0.01
BILLING_DEFAULT_POINT_VIEW_FEE_ENABLED=true
BILLING_DEFAULT_RESERVATION_FAILURE_FEE=0.00

# Scheduler control plane - replace SCHEDULER_INTERNAL_TOKEN before strict mode.
SCHEDULER_TICK_SECONDS=15
SCHEDULER_MAX_CONCURRENT_JOBS=2
SCHEDULER_INSTANCE_ID=scheduler-service-1
SCHEDULER_INTERNAL_TOKEN=change-me-scheduler-token
SCHEDULER_HTTP_TIMEOUT_SECONDS=10
SCHEDULER_RUN_LOOP=true
CATALOG_SERVICE_URL=http://catalog-service:8000
ANALYTICS_SERVICE_URL=http://analytics-service:8000
BILLING_SERVICE_URL=http://billing-service:8000
RESERVATION_SERVICE_URL=http://reservation-service:8000

# PostgreSQL local defaults
POSTGRES_USER=saasplug15
POSTGRES_PASSWORD=saasplug15

# Provider base URLs
PROVIDER_API_TIMEOUT_SECONDS=10
PROVIDER_AUTH_SCHEME=Bearer
RED_PROVIDER_BASE_URL=https://davinci.softlab.ntua.gr/saas26/redPlug/api
GREEN_PROVIDER_BASE_URL=https://davinci.softlab.ntua.gr/saas26/greenPlug/api
BLUE_PROVIDER_BASE_URL=https://davinci.softlab.ntua.gr/saas26/bluePlug/api

# Internal provider-service URLs used by catalog-service imports
RED_PROVIDER_SERVICE_URL=http://red-provider-service:8000
GREEN_PROVIDER_SERVICE_URL=http://green-provider-service:8000
BLUE_PROVIDER_SERVICE_URL=http://blue-provider-service:8000
STATUS_SERVICE_URL=http://status-service:8000
CATALOG_PROVIDER_HTTP_TIMEOUT_SECONDS=10
CATALOG_STATUS_SEED_TIMEOUT_SECONDS=5
CATALOG_IMPORT_ON_STARTUP=false
STATUS_CACHE_TTL_SECONDS=300
STATUS_PROVIDER_TIMEOUT_SECONDS=10
RESERVATION_CATALOG_SERVICE_URL=http://catalog-service:8000
RESERVATION_PROVIDER_TIMEOUT_SECONDS=5
RESERVATION_OUTBOX_PUBLISH_BATCH_SIZE=50

# Provider credentials / team keys, if required by provider specs
RED_PROVIDER_API_KEY=replace-me
GREEN_PROVIDER_API_KEY=replace-me
BLUE_PROVIDER_API_KEY=replace-me

# Database placeholders
AUTH_DATABASE_URL=postgresql://saasplug15:saasplug15@auth-postgres:5432/auth
PROVIDER_REGISTRY_DATABASE_URL=postgresql://saasplug15:saasplug15@provider-registry-postgres:5432/provider_registry
RED_PROVIDER_DATABASE_URL=postgresql://saasplug15:saasplug15@red-provider-postgres:5432/red_provider
GREEN_PROVIDER_DATABASE_URL=postgresql://saasplug15:saasplug15@green-provider-postgres:5432/green_provider
BLUE_PROVIDER_DATABASE_URL=postgresql://saasplug15:saasplug15@blue-provider-postgres:5432/blue_provider
CATALOG_DATABASE_URL=postgresql://saasplug15:saasplug15@catalog-postgres:5432/catalog
STATUS_DATABASE_URL=postgresql://saasplug15:saasplug15@status-postgres:5432/status
RESERVATION_DATABASE_URL=postgresql://saasplug15:saasplug15@reservation-postgres:5432/reservation
ANALYTICS_DATABASE_URL=postgresql://saasplug15:saasplug15@analytics-postgres:5432/analytics
BILLING_DATABASE_URL=postgresql://saasplug15:saasplug15@billing-postgres:5432/billing
SCHEDULER_DATABASE_URL=postgresql://saasplug15:saasplug15@scheduler-postgres:5432/scheduler
