@startuml
title Provider sync and catalog import sequence

actor "OPERATOR" as Operator
participant "frontend" as Frontend
participant "nginx-gateway" as Gateway
participant "scheduler-service" as Scheduler
database "scheduler-postgres" as SchedulerDb
participant ProviderService
participant "External provider API" as ProviderApi
database "provider-local PostgreSQL" as ProviderDb
participant "catalog-service" as Catalog
database "catalog-postgres" as CatalogDb
queue "RabbitMQ\nsaasplug.events" as RabbitMQ

alt Manual scheduler run
  Operator -> Frontend : Trigger scheduler import job
  Frontend -> Gateway : POST /api/scheduler/jobs/catalog.import.all/run
  Gateway -> Scheduler : Operator-authorized manual run
else Scheduled interval
  Scheduler -> SchedulerDb : Read due catalog.import.all job
end

Scheduler -> Catalog : POST /internal/jobs/catalog/imports/all\nX-Scheduler-Token
Catalog -> ProviderService : Internal normalized snapshot request
ProviderService -> ProviderApi : Fetch provider-specific catalog
ProviderApi --> ProviderService : Provider-specific payload
ProviderService -> ProviderService : Normalize to internal DTOs
ProviderService -> ProviderDb : Store raw payloads, snapshots, sync run, changes
ProviderService -> RabbitMQ : provider.points.snapshot_ready event
ProviderService --> Catalog : Snapshot page
Catalog -> CatalogDb : Upsert catalog_points and import records
Catalog -> RabbitMQ : catalog.points.imported event
Catalog --> Scheduler : Import summary and freshness
Scheduler -> SchedulerDb : Store job_run status and summary
Scheduler --> Gateway : Manual run result
Gateway --> Frontend : Control result
Frontend --> Operator : Show scheduler run result

@enduml
