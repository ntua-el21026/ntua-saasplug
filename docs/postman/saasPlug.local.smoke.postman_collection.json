              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('request URL uses baseUrl variable', function () {",
                  "  pm.expect(pm.request.url.toString()).to.match(/^\\{\\{baseUrl\\}\\}/);",
                  "});",
                  "const forbiddenHosts = [",
                  "  'davinci.softlab.ntua.gr',",
                  "  'auth-service',",
                  "  'catalog-service',",
                  "  'status-service',",
                  "  'reservation-service',",
                  "  'analytics-service',",
                  "  'billing-service',",
                  "  'scheduler-service',",
                  "  'provider-registry-service',",
                  "  'red-provider-service',",
                  "  'green-provider-service',",
                  "  'blue-provider-service'",
                  "];",
                  "pm.test('request URL does not use forbidden hosts', function () {",
                  "  const rawUrl = pm.request.url.toString();",
                  "  forbiddenHosts.forEach(function (host) {",
                  "    pm.expect(rawUrl, host).to.not.include(host);",
                  "  });",
                  "});",
                  "pm.test('login returns token payload', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('access_token').that.is.a('string').and.is.not.empty;",
                  "  pm.expect(json).to.have.property('refresh_token').that.is.a('string').and.is.not.empty;",
                  "  pm.expect(json).to.have.property('token_type', 'bearer');",
                  "  pm.expect(json.user.roles).to.include('EV_USER');",
                  "  pm.environment.set('evAccessToken', json.access_token);",
                  "  pm.environment.set('evRefreshToken', json.refresh_token);",
                  "});"
                ]
              }
            }
