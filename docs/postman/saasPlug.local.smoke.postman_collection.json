    {
      "name": "EV Read Flow",
      "item": [
        {
          "name": "Catalog radius list and capture first point",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{evAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/points?centerLat=37.9838&centerLng=23.7275&radiusKm=10&limit=25&includeStale=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('request URL uses baseUrl variable', function () {",
                  "  pm.expect(pm.request.url.toString()).to.match(/^\\{\\{baseUrl\\}\\}/);",
                  "});",
                  "const forbiddenHosts = [",
                  "  'davinci.softlab.ntua.gr',",
                  "  'auth-service',",
                  "  'catalog-service',",
                  "  'status-service',",
                  "  'reservation-service',",
                  "  'analytics-service',",
                  "  'billing-service',",
                  "  'scheduler-service',",
                  "  'provider-registry-service',",
                  "  'red-provider-service',",
                  "  'green-provider-service',",
                  "  'blue-provider-service'",
                  "];",
                  "pm.test('request URL does not use forbidden hosts', function () {",
                  "  const rawUrl = pm.request.url.toString();",
                  "  forbiddenHosts.forEach(function (host) {",
                  "    pm.expect(rawUrl, host).to.not.include(host);",
                  "  });",
                  "});",
                  "pm.test('catalog list returns pagination metadata', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('items').that.is.an('array');",
                  "  pm.expect(json).to.have.property('total');",
                  "  pm.expect(json).to.have.property('limit');",
                  "  pm.expect(json).to.have.property('offset');",
                  "});",
                  "const payload = pm.response.json();",
                  "const point = (payload.items || []).find(function (item) {",
                  "  return item && item.provider_code && item.external_point_id;",
                  "});",
                  "if (point) {",
                  "  pm.environment.set('pointId', point.id || '');",
                  "  pm.environment.set('normalizedPointId', point.normalized_point_id || '');",
                  "  pm.environment.set('providerCode', point.provider_code || pm.environment.get('providerCode'));",
                  "  pm.environment.set('externalPointId', point.external_point_id || '');",
                  "  pm.test('captured a usable catalog point', function () {",
                  "    pm.expect(pm.environment.get('providerCode')).to.not.be.empty;",
                  "    pm.expect(pm.environment.get('externalPointId')).to.not.be.empty;",
                  "  });",
                  "} else {",
                  "  pm.test('catalog may be empty on a fresh stack', function () {",
                  "    pm.expect(payload.items.length).to.eql(0);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Catalog point detail if captured",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{evAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{pointDetailPath}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const providerCode = pm.environment.get('providerCode');",
                  "const externalPointId = pm.environment.get('externalPointId');",
                  "if (providerCode && externalPointId) {",
                  "  pm.variables.set('pointReady', 'true');",
                  "  pm.variables.set('pointDetailPath', '/api/catalog/points/' + encodeURIComponent(providerCode) + '/' + encodeURIComponent(externalPointId));",
                  "  pm.variables.set('statusLookupPath', '/api/status/points/' + encodeURIComponent(providerCode) + '/' + encodeURIComponent(externalPointId) + '/status?forceRefresh=false');",
                  "  pm.variables.set('statusCachePath', '/api/status/cache/' + encodeURIComponent(providerCode) + '/' + encodeURIComponent(externalPointId));",
                  "  pm.variables.set('reservationPath', '/api/reservations/points/' + encodeURIComponent(providerCode) + '/' + encodeURIComponent(externalPointId) + '/reservations');",
                  "} else {",
                  "  pm.variables.set('pointReady', 'false');",
                  "  pm.variables.set('pointDetailPath', '/health');",
                  "  pm.variables.set('statusLookupPath', '/health');",
                  "  pm.variables.set('statusCachePath', '/health');",
                  "  pm.variables.set('reservationPath', '/health');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('request URL uses baseUrl variable', function () {",
                  "  pm.expect(pm.request.url.toString()).to.match(/^\\{\\{baseUrl\\}\\}/);",
                  "});",
                  "const forbiddenHosts = [",
                  "  'davinci.softlab.ntua.gr',",
                  "  'auth-service',",
                  "  'catalog-service',",
                  "  'status-service',",
                  "  'reservation-service',",
                  "  'analytics-service',",
                  "  'billing-service',",
                  "  'scheduler-service',",
                  "  'provider-registry-service',",
                  "  'red-provider-service',",
                  "  'green-provider-service',",
                  "  'blue-provider-service'",
                  "];",
                  "pm.test('request URL does not use forbidden hosts', function () {",
                  "  const rawUrl = pm.request.url.toString();",
                  "  forbiddenHosts.forEach(function (host) {",
                  "    pm.expect(rawUrl, host).to.not.include(host);",
                  "  });",
                  "});",
                  "if (pm.variables.get('pointReady') === 'false') {",
                  "  pm.test('skipped point detail because no catalog point was captured', function () { pm.response.to.have.status(200); });",
                  "} else {",
                  "  pm.test('point detail returns captured point identity', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.provider_code).to.eql(pm.environment.get('providerCode'));",
                  "    pm.expect(json.external_point_id).to.eql(pm.environment.get('externalPointId'));",
                  "    pm.expect(json).to.have.property('raw_provider_payload');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Status lookup if point captured",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{evAccessToken}}"
