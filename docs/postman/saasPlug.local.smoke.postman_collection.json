{
  "info": {
    "name": "saasPlug.local.smoke",
    "description": "Fast app-level sanity checks through the local Nginx gateway only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('request URL uses baseUrl variable', function () {",
                  "  pm.expect(pm.request.url.toString()).to.match(/^\\{\\{baseUrl\\}\\}/);",
                  "});",
                  "const forbiddenHosts = [",
                  "  'davinci.softlab.ntua.gr',",
                  "  'auth-service',",
                  "  'catalog-service',",
                  "  'status-service',",
                  "  'reservation-service',",
                  "  'analytics-service',",
                  "  'billing-service',",
                  "  'scheduler-service',",
                  "  'provider-registry-service',",
                  "  'red-provider-service',",
                  "  'green-provider-service',",
                  "  'blue-provider-service'",
                  "];",
                  "pm.test('request URL does not use forbidden hosts', function () {",
                  "  const rawUrl = pm.request.url.toString();",
                  "  forbiddenHosts.forEach(function (host) {",
                  "    pm.expect(rawUrl, host).to.not.include(host);",
                  "  });",
                  "});",
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code !== 204 && pm.response.text()) {",
                  "  pm.test('response body is JSON object', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
